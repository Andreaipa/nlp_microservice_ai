# ---------------------------------------------------------------------------
# Configuración del microservicio. Copie a .env y ajuste.
# Todas las variables llevan el prefijo AI_.
# ---------------------------------------------------------------------------

# --- Servicio --------------------------------------------------------------
AI_ENVIRONMENT=local                # local | dev | staging | prod
AI_DEBUG=false
AI_HOST=0.0.0.0
AI_PORT=8000
AI_SERVICE_VERSION=1.0.0

# --- Detección -------------------------------------------------------------
# heuristic  -> sin modelo entrenado; el servicio funciona en modo degradado
# onnx       -> modelo exportado (producción)
# ultralytics-> pesos .pt (desarrollo)
AI_DETECTOR_BACKEND=heuristic
AI_DETECTOR_MODEL_PATH=models/detector.onnx
AI_DETECTOR_INPUT_SIZE=960
AI_DETECTOR_CONF_THRESHOLD=0.25
AI_DETECTOR_IOU_THRESHOLD=0.45
# Márgenes al recortar la región detectada. El inferior es mayor porque el
# troquelado está siempre por debajo de la válvula y el asa.
AI_DETECTOR_CROP_PADDING=0.15
AI_DETECTOR_CROP_PADDING_BOTTOM=0.90

# --- OCR -------------------------------------------------------------------
# rapid  -> RapidOCR sobre ONNX Runtime. ~10x más rápido que paddle en CPU y
#           sin dependencias extra. Recomendado (ver docs/RENDIMIENTO.md).
# paddle -> PaddleOCR. Reconoce más texto secundario, a cambio de latencia y
#           de ~600 MB de dependencias.
AI_OCR_BACKEND=rapid                # rapid | paddle | null
AI_OCR_LANG=en                      # sólo aplica a paddle
AI_OCR_USE_GPU=false
AI_OCR_MIN_CONFIDENCE=0.30
# Hilos del motor OCR. 0 = automático. En equipos modestos, 2 evita que una
# sola petición acapare la máquina.
AI_OCR_THREADS=0
# Variantes de realce que se prueban por recorte. Más variantes dan lecturas
# más robustas por consenso, a costa de latencia (una pasada de OCR cada una).
AI_OCR_PREPROCESS_VARIANTS=3

# --- Umbrales de decisión --------------------------------------------------
# Póngalo a true sólo después de ejecutar training/calibrate_thresholds.py
# sobre el conjunto de test real. Mientras sea false, el servicio marca todo
# para confirmación manual.
#
# Con el modelo actual la calibración concluyó que no existe un umbral que
# mantenga el error silencioso por debajo del 1%, de modo que la aceptación
# automática queda deshabilitada (1.00). Si un modelo futuro mejora la
# lectura, hay que volver a calibrar y bajar este valor.
AI_THRESHOLDS_CALIBRATED=true
AI_SERIAL_AUTO_ACCEPT_CONFIDENCE=1.00
AI_SERIAL_REVIEW_CONFIDENCE=0.70
AI_CATALOG_FUZZY_MAX_DISTANCE=2
AI_CATALOG_FUZZY_MARGIN=1

# --- Catálogo de cilindros -------------------------------------------------
AI_CATALOG_ENABLED=true
# Catálogo del inventario, generado por training/build_catalog.py a partir de
# las fichas de cada cilindro.
AI_CATALOG_PATH=datasets/catalog.json

# --- Backend principal -----------------------------------------------------
AI_BACKEND_ENABLED=false
AI_BACKEND_BASE_URL=http://backend:3000/api
AI_BACKEND_API_KEY=
AI_BACKEND_TIMEOUT_SECONDS=5.0

# --- Entrada ---------------------------------------------------------------
AI_MAX_UPLOAD_BYTES=15728640
AI_MAX_IMAGE_SIDE=2048

# --- Observabilidad --------------------------------------------------------
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true
AI_AUDIT_ENABLED=true
AI_AUDIT_DIR=datasets/audit
AI_AUDIT_STORE_IMAGES_ON_REVIEW=true
AI_AUDIT_RETENTION_DAYS=30
